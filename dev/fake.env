# Settings for fake mode (`pnpm dev`), read instead of .dev.vars.
# Every value is a synthetic placeholder that protects nothing: the fake Strava
# in dev/fake-strava/ accepts these credentials and no real service ever sees
# them (specs/006-local-frontend-dev/data-model.md, "Fake mode settings").
#
# Wrangler only loads the secrets wrangler.jsonc declares from this file, and
# lets the shell's environment override them. So `pnpm dev` unsets those
# variables for Wrangler, and passes the fake-mode marker RYNKE_FAKE_STRAVA,
# which isn't a declared secret, with `--var`.

STRAVA_CLIENT_ID=90001
STRAVA_CLIENT_SECRET=fake-client-secret
STRAVA_WEBHOOK_VERIFY_TOKEN=fake-verify-token
ADMIN_TOKEN=fake-admin-token

# Bytes 0x40..0x5f and 0x60..0x7f, base64.
TOKEN_ENCRYPTION_KEY=QEFCQ0RFRkdISUpLTE1OT1BRUlNUVVZXWFlaW1xdXl8=
SESSION_SIGNING_KEY=YGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6e3x9fn8=

# Synthetic EC P-256 key (JWK) for notifications. Its pushes only reach the
# developer's own browser through that browser's push service (010 research
# R15); it is never used in production.
PUSH_VAPID_KEY='{"kty":"EC","crv":"P-256","x":"4JfsEeQguqEH12-Bdlc-pRrJHkZIhZaY6gl0jkZgZLQ","y":"VYbVw2JYss4idELGV05XH6LlkyHzukxAANl0pRtm8MA","d":"GaXbTh0rANQSQeG_X_ONTnlG2uM3mDEwanzcza5jsdU"}'
