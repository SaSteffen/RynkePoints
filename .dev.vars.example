# Copy to .dev.vars for `pnpm dev:strava` (the real Strava) and tests' local
# overrides; `pnpm dev` uses dev/fake.env instead. Never commit .dev.vars.
# Production values are set with `pnpm wrangler secret put <NAME>`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Random string you choose; Strava echoes it back when validating the webhook subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# 32 random bytes, base64: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# 32 random bytes, base64: `openssl rand -base64 32`
SESSION_SIGNING_KEY=
# Starts the daily run on demand (scripts/run-daily.sh). 32 random bytes, base64: `openssl rand -base64 32`
ADMIN_TOKEN=
# EC P-256 private key as JWK JSON; see README (keep it: a new key ends every device's notifications)
PUSH_VAPID_KEY=
