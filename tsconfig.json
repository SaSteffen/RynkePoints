{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"types": [
			"./worker-configuration.d.ts",
			"@cloudflare/vitest-pool-workers/types"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src", "dev", "test", "vitest.config.ts"]
}
