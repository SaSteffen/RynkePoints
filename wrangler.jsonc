{
	"$schema": "node_modules/wrangler/config-schema.json",
	// No team at the top level: every command names one, `--env hamburg` or
	// `--env europe`. Without it Wrangler would take the name from package.json,
	// which is Hamburg's Worker, and deploy it with no bindings; this name and
	// the missing entry file make such a deploy fail instead.
	"name": "no-team-use-env",
	"main": "use-env-hamburg-or-env-europe.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		// No per-request invocation logs: they record the request URL, and the
		// Strava webhook's URL carries its secret. Our own log lines stay.
		"logs": {
			"invocation_logs": false
		}
	},
	// Unmodified Strava brand assets (see public/strava/README.md).
	"assets": {
		"directory": "./public"
	},
	"workers_dev": false,
	"preview_urls": false,
	// `wrangler dev` only (`pnpm dev` and `pnpm dev:strava`); deploys ignore it.
	// 8787, Wrangler's default, is taken on the maintainer's machine. Without
	// `host`, wrangler dev hands the Worker URLs on the first route's host (the
	// production domain), and the OAuth redirect would point there.
	"dev": {
		"port": 8789,
		"host": "localhost:8789"
	},
	// One block per team, the founding team first (feature 026 research R1).
	// Wrangler doesn't inherit vars, bindings or secrets into a block, so each
	// block lists all of them; `node scripts/team-check.mjs` keeps them alike.
	"env": {
		// Team Rynkeby Hamburg, the founding team, `--env hamburg`. Its Worker,
		// database, queue and domain kept their names when it moved here from
		// the top level.
		"hamburg": {
			"name": "rynke-points",
			"main": "src/index.ts",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rynke-points",
					// From `wrangler d1 create rynke-points --jurisdiction=eu`.
					"database_id": "f1493f0b-1930-48de-afc5-f6edda211092",
					"migrations_dir": "migrations"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "WORK_QUEUE",
						"queue": "rynke-points-work"
					}
				],
				"consumers": [
					{
						"queue": "rynke-points-work",
						"max_batch_size": 10,
						"max_batch_timeout": 5,
						"max_retries": 10,
						"max_concurrency": 1
					}
				]
			},
			// Daily membership check and failed_work re-enqueue; hourly usage recording
			// and alerts (025 research R2). `handleScheduled` tells them apart.
			"triggers": {
				"crons": ["17 3 * * *", "58 * * * *"]
			},
			// Team settings (data-model.md). Changing them is a deploy, not a code change.
			"vars": {
				// The team's Strava club: the one the app links to and names.
				"STRAVA_CLUB_ID": "1088689",
				// Further clubs whose members may take part too, comma-separated, never
				// named in the app; "" for none.
				"STRAVA_EXTRA_CLUB_IDS": "2372209",
				"SEASON_START_DATE": "2026-09-01",
				// Last day rides and team events count; the even pace runs to it (016).
				"QUALIFICATION_DEADLINE": "2027-06-30",
				// What organisers see of each rider's Rynke on /organiser/riders:
				// "full" (amounts, what is missing, where they come from) or "percent"
				// (Training and Team as a share of their threshold, up to 100 %; the
				// corrections as amounts).
				"ORGANISER_FIGURES": "full",
				// "on" adds the Progress section with daily figures to /organiser/riders,
				// for riders on consent version 3 or higher, while ORGANISER_FIGURES is
				// "full". It never changes the consent versions. "on" or "off".
				"ORGANISER_PROGRESS_GRAPH": "on",
				// The Strava gateway's webhook subscription, the same in every team. The
				// optional secret STRAVA_SUBSCRIPTION_ID_OVERRIDE wins while it is set
				// (docs/gateway-switch.md step 3).
				"STRAVA_SUBSCRIPTION_ID": "385000",
				// VAPID contact for the push services (010 research R4).
				"PUSH_SUBJECT": "https://trhh-rynke-coins.link",
				// Seconds between the waiting page's checks for the first data, 1–60
				// (015 research R5).
				"READY_POLL_SECONDS": "10",
				// "off" ranks no rider by Training Rynke on /team: no place card, no
				// Training leaderboard, no Training figure in the Team rows. The team
				// total, the peloton and the team chart stay. "on" or "off".
				"TRAINING_LEADERBOARD": "on",
				// "on" lets /team rank riders by sessions, km and elevation without names,
				// and gives organisers the Sessions column and graph, for riders on
				// consent version 3 or higher (feature 032). "on" or "off".
				"RIDE_FIGURES": "on",
				// "off" gives /team one view without Rynke: the team's ride figures, a km
				// chart and the ride ranking (feature 032 FR-012). "on" or "off".
				"RYNKE_VIEWS": "on",
				// Feature switches per team (feature 026 FR-018), each "on" or "off":
				// "off" leaves out every page, menu entry, text, notification and
				// scheduled work of the feature. The badges; the Team page's
				// motivational phrases; the season album; the fun themes Konfetti and
				// Disco in the theme menu.
				"BADGES": "on",
				"PHRASES": "on",
				"SEASON_ALBUM": "on",
				"FUN_THEMES": "on",
				// Who is responsible for the riders' data, and how to reach them, for
				// the privacy page (/privacy). One line each; the contact is the email.
				"PRIVACY_CONTROLLER": "Sascha Steffen",
				"CONTACT_EMAIL": "support@trhh-rynke-coins.link",
				// Labels this team's usage records, for feature 026's shares (025 R13).
				"TEAM_ID": "hamburg",
				// "" sends riders back from Strava to this site's /auth/callback; the
				// Strava gateway's origin sends them through it (feature 026 release 3,
				// contracts/gateway.md). Back to "" to switch back (docs/gateway-switch.md).
				"STRAVA_RETURN_VIA": "https://gateway.trhh-rynke-coins.link",
				// The other teams whose usage counts the admin view shows beside this
				// team's (feature 026 contracts/usage-exchange.md): JSON list of
				// { "id", "origin" }, like the gateway's TEAMS. "[]" for none.
				"USAGE_PEERS": "[]"
			},
			// Set with `wrangler secret put` in production and `.dev.vars` locally. Listing
			// them here makes `pnpm types` independent of what's in your `.dev.vars`.
			// CLOUDFLARE_ANALYTICS_TOKEN and CLOUDFLARE_ANALYTICS_ACCOUNT_ID are optional,
			// so they aren't listed and a deploy works without them: Cloudflare's figures
			// then count as unavailable (025 contracts/cloudflare-analytics.md).
			// USAGE_EXCHANGE_TOKEN is optional too: the same value in every team, for
			// the usage export (026 contracts/usage-exchange.md); without it no team's
			// counts are exchanged.
			"secrets": {
				"required": [
					"STRAVA_CLIENT_ID",
					"STRAVA_CLIENT_SECRET",
					"STRAVA_WEBHOOK_VERIFY_TOKEN",
					"TOKEN_ENCRYPTION_KEY",
					"SESSION_SIGNING_KEY",
					"ADMIN_TOKEN",
					"PUSH_VAPID_KEY"
				]
			},
			"routes": [
				{
					"pattern": "trhh-rynke-coins.link",
					"custom_domain": true
				}
			]
		},
		// Team Rynkeby Europe (feature 026), `--env europe`. Placeholders until release 4
		// (src/teams/europe.ts `placeholders`): the resource IDs, club IDs, dates,
		// controller and contact.
		"europe": {
			"name": "rynke-points-europe",
			"main": "src/index.ts",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rynke-points-europe",
					// Placeholder, until `wrangler d1 create rynke-points-europe`.
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "WORK_QUEUE",
						"queue": "rynke-points-europe-work"
					}
				],
				"consumers": [
					{
						"queue": "rynke-points-europe-work",
						"max_batch_size": 10,
						"max_batch_timeout": 5,
						"max_retries": 10,
						"max_concurrency": 1
					}
				]
			},
			"triggers": {
				"crons": ["17 3 * * *", "58 * * * *"]
			},
			"vars": {
				// Placeholder: Europe's club once it has one.
				"STRAVA_CLUB_ID": "0",
				"STRAVA_EXTRA_CLUB_IDS": "",
				// Placeholders: Hamburg's dates.
				"SEASON_START_DATE": "2026-09-01",
				"QUALIFICATION_DEADLINE": "2027-06-30",
				"ORGANISER_FIGURES": "full",
				"ORGANISER_PROGRESS_GRAPH": "on",
				// The gateway's subscription, like every team's.
				"STRAVA_SUBSCRIPTION_ID": "385000",
				"PUSH_SUBJECT": "https://europe.trhh-rynke-coins.link",
				"READY_POLL_SECONDS": "10",
				"TRAINING_LEADERBOARD": "on",
				"RIDE_FIGURES": "on",
				"RYNKE_VIEWS": "on",
				"BADGES": "on",
				"PHRASES": "on",
				"SEASON_ALBUM": "on",
				"FUN_THEMES": "on",
				// Placeholders until Europe names its controller and contact.
				"PRIVACY_CONTROLLER": "Placeholder Controller",
				"CONTACT_EMAIL": "privacy@example.org",
				"TEAM_ID": "europe",
				"STRAVA_RETURN_VIA": "",
				"USAGE_PEERS": "[{\"id\":\"hamburg\",\"origin\":\"https://trhh-rynke-coins.link\"}]"
			},
			"secrets": {
				"required": [
					"STRAVA_CLIENT_ID",
					"STRAVA_CLIENT_SECRET",
					"STRAVA_WEBHOOK_VERIFY_TOKEN",
					"TOKEN_ENCRYPTION_KEY",
					"SESSION_SIGNING_KEY",
					"ADMIN_TOKEN",
					"PUSH_VAPID_KEY"
				]
			},
			// For now a subdomain of Hamburg's domain; Europe's own domain comes
			// later (spec 026 clarification 2026-11-09).
			"routes": [
				{
					"pattern": "europe.trhh-rynke-coins.link",
					"custom_domain": true
				}
			]
		},
		// Hamburg's release sandbox (feature 027), `--env sandbox-hamburg`: fake mode
		// (dev/worker.ts) with sample riders only, for maintainers behind Access.
		// Every var as Hamburg's except those team-check allows to differ.
		"sandbox-hamburg": {
			"name": "rynke-points-sandbox-hamburg",
			"main": "dev/worker.ts",
			"workers_dev": false,
			"preview_urls": false,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rynke-points-sandbox-hamburg",
					// Placeholder, until `wrangler d1 create rynke-points-sandbox-hamburg`.
					"database_id": "00000000-0000-0000-0000-000000000001",
					"migrations_dir": "migrations"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "WORK_QUEUE",
						"queue": "rynke-points-sandbox-hamburg-work"
					}
				],
				"consumers": [
					{
						"queue": "rynke-points-sandbox-hamburg-work",
						"max_batch_size": 10,
						"max_batch_timeout": 5,
						"max_retries": 10,
						"max_concurrency": 1
					}
				]
			},
			// No triggers: sandboxes use none of the account's five crons (FR-032);
			// `POST /_dev/scheduled` runs the daily work instead.
			"vars": {
				"STRAVA_CLUB_ID": "1088689",
				"STRAVA_EXTRA_CLUB_IDS": "2372209",
				"SEASON_START_DATE": "2026-09-01",
				"QUALIFICATION_DEADLINE": "2027-06-30",
				"ORGANISER_FIGURES": "full",
				"ORGANISER_PROGRESS_GRAPH": "on",
				"STRAVA_SUBSCRIPTION_ID": "385000",
				"PUSH_SUBJECT": "https://sandbox-hamburg.trhh-rynke-coins.link",
				"READY_POLL_SECONDS": "10",
				"TRAINING_LEADERBOARD": "on",
				"RIDE_FIGURES": "on",
				"RYNKE_VIEWS": "on",
				"BADGES": "on",
				"PHRASES": "on",
				"SEASON_ALBUM": "on",
				"FUN_THEMES": "on",
				"PRIVACY_CONTROLLER": "Sascha Steffen",
				"CONTACT_EMAIL": "support@trhh-rynke-coins.link",
				"TEAM_ID": "hamburg",
				"STRAVA_RETURN_VIA": "",
				"USAGE_PEERS": "[]",
				// Fake mode in a sandbox: closed by Cloudflare Access and checked again by
				// the Worker (027 contracts/access-check.md).
				"RYNKE_FAKE_STRAVA": "sandbox",
				"SANDBOX_HOST": "sandbox-hamburg.trhh-rynke-coins.link",
				// Placeholders until the Access application exists (027 quickstart).
				"ACCESS_TEAM_DOMAIN": "placeholder.cloudflareaccess.com",
				"ACCESS_AUD": "placeholder-access-aud"
			},
			"secrets": {
				"required": [
					"STRAVA_CLIENT_ID",
					"STRAVA_CLIENT_SECRET",
					"STRAVA_WEBHOOK_VERIFY_TOKEN",
					"TOKEN_ENCRYPTION_KEY",
					"SESSION_SIGNING_KEY",
					"ADMIN_TOKEN",
					"PUSH_VAPID_KEY"
				]
			},
			"routes": [
				{
					"pattern": "sandbox-hamburg.trhh-rynke-coins.link",
					"custom_domain": true
				}
			]
		},
		// Europe's release sandbox, `--env sandbox-europe`, like Hamburg's.
		"sandbox-europe": {
			"name": "rynke-points-sandbox-europe",
			"main": "dev/worker.ts",
			"workers_dev": false,
			"preview_urls": false,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rynke-points-sandbox-europe",
					// Placeholder, until `wrangler d1 create rynke-points-sandbox-europe`.
					"database_id": "00000000-0000-0000-0000-000000000002",
					"migrations_dir": "migrations"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "WORK_QUEUE",
						"queue": "rynke-points-sandbox-europe-work"
					}
				],
				"consumers": [
					{
						"queue": "rynke-points-sandbox-europe-work",
						"max_batch_size": 10,
						"max_batch_timeout": 5,
						"max_retries": 10,
						"max_concurrency": 1
					}
				]
			},
			// No triggers: sandboxes use none of the account's five crons (FR-032);
			// `POST /_dev/scheduled` runs the daily work instead.
			"vars": {
				"STRAVA_CLUB_ID": "0",
				"STRAVA_EXTRA_CLUB_IDS": "",
				"SEASON_START_DATE": "2026-09-01",
				"QUALIFICATION_DEADLINE": "2027-06-30",
				"ORGANISER_FIGURES": "full",
				"ORGANISER_PROGRESS_GRAPH": "on",
				"STRAVA_SUBSCRIPTION_ID": "385000",
				"PUSH_SUBJECT": "https://sandbox-europe.trhh-rynke-coins.link",
				"READY_POLL_SECONDS": "10",
				"TRAINING_LEADERBOARD": "on",
				"RIDE_FIGURES": "on",
				"RYNKE_VIEWS": "on",
				"BADGES": "on",
				"PHRASES": "on",
				"SEASON_ALBUM": "on",
				"FUN_THEMES": "on",
				"PRIVACY_CONTROLLER": "Placeholder Controller",
				"CONTACT_EMAIL": "privacy@example.org",
				"TEAM_ID": "europe",
				"STRAVA_RETURN_VIA": "",
				"USAGE_PEERS": "[]",
				// Fake mode in a sandbox: closed by Cloudflare Access and checked again by
				// the Worker (027 contracts/access-check.md).
				"RYNKE_FAKE_STRAVA": "sandbox",
				"SANDBOX_HOST": "sandbox-europe.trhh-rynke-coins.link",
				// Placeholders until the Access application exists (027 quickstart).
				"ACCESS_TEAM_DOMAIN": "placeholder.cloudflareaccess.com",
				"ACCESS_AUD": "placeholder-access-aud"
			},
			"secrets": {
				"required": [
					"STRAVA_CLIENT_ID",
					"STRAVA_CLIENT_SECRET",
					"STRAVA_WEBHOOK_VERIFY_TOKEN",
					"TOKEN_ENCRYPTION_KEY",
					"SESSION_SIGNING_KEY",
					"ADMIN_TOKEN",
					"PUSH_VAPID_KEY"
				]
			},
			"routes": [
				{
					"pattern": "sandbox-europe.trhh-rynke-coins.link",
					"custom_domain": true
				}
			]
		}
	}
}
