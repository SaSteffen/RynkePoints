# Response headers for the static assets (Workers static assets).

# The rules handout downloads as a file in every browser, not only where the
# link's `download` attribute works (feature 005 research R14).
/rynke-punkte.pdf
  Content-Disposition: attachment; filename="rynke-punkte.pdf"

# The chart library (feature 009 research R6). The file names carry the
# version, so a new version is a new URL and the old one never changes.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The badge, coin, illustration and icon art keeps its URLs when the files
# change, so it stays fresh for a day and is reused for a week while the
# browser checks for a new version in the background (issue #182).
/badges/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/coin/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/illustrations/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
