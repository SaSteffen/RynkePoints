# Response headers for the static assets (Workers static assets).

# The rules handout downloads as a file in every browser, not only where the
# link's `download` attribute works (feature 005 research R14).
/rynke-punkte.pdf
  Content-Disposition: attachment; filename="rynke-punkte.pdf"

# The chart library (feature 009 research R6). The file names carry the
# version, so a new version is a new URL and the old one never changes.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The badge, coin, illustration and quote monkey art: the app links each
# picture with a hash of the file (`?v=<hash>`, scripts/art-versions.mjs), so a
# changed picture gets a new address and the old one never changes.
/badges/*
  Cache-Control: public, max-age=31536000, immutable

/coin/*
  Cache-Control: public, max-age=31536000, immutable

/illustrations/*
  Cache-Control: public, max-age=31536000, immutable

/quotes/*
  Cache-Control: public, max-age=31536000, immutable

# The icons keep their addresses (the manifest, the service worker, the
# page's <head>), so they stay fresh for a day and are reused for a week while
# the browser checks for a new version in the background (issue #182).
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
