# Claude Code local/personal settings (per-machine, not project config)
.claude/settings.local.json

node_modules/

# Wrangler's local state: dev-mode D1/KV/Queue contents (may hold real rider
# data copied down for debugging) and build output.
.wrangler/
dist/

# Local secrets — Strava client secret, token encryption key, etc. Production
# secrets live in Cloudflare (`wrangler secret put`), never in git
# (constitution Principle I). .dev.vars.example IS committed.
.dev.vars*
!.dev.vars.example
.env*

# Logs and Python bytecode (from the vendored Spec Kit scripts)
*.log
__pycache__/
